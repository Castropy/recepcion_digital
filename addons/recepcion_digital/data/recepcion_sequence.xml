<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Secuencia correlativa para folios de recepcion de arroz -->
        <record id="seq_recepcion_arroz" model="ir.sequence">
            <field name="name">Secuencia de Recepción de Arroz Paddy</field>
            <field name="code">recepcion.arroz</field>
            <field name="prefix">REC/%(year)s/%(month)s/</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>