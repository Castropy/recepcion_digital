<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Acción de Reporte PDF QWeb -->
    <record id="action_report_recepcion_arroz" model="ir.actions.report">
        <field name="name">Comprobante de Recepción</field>
        <field name="model">recepcion.arroz</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">recepcion_digital.report_recepcion_arroz_document</field>
        <field name="report_file">recepcion_digital.report_recepcion_arroz_document</field>
        <field name="print_report_name">'Comprobante_Recepcion_%s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="model_recepcion_arroz"/>
        <field name="binding_type">report</field>
    </record>

</odoo>