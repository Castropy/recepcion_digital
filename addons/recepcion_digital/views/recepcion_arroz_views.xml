<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario -->
    <record id="view_recepcion_arroz_form" model="ir.ui.view">
        <field name="name">recepcion.arroz.form</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <form string="Recepción de Arroz">
                <header>
                    <button name="action_completar" string="Completar" type="object" class="oe_highlight" invisible="state != 'borrador'"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state == 'borrador'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,completado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Datos del Proveedor / Guía">
                            <field name="partner_id"/>
                            <field name="guia_sica"/>
                            <field name="date_recepcion"/>
                        </group>
                        <group string="Datos del Transporte">
                            <field name="vehiculo_placa"/>
                            <field name="chofer_cedula"/>
                            <field name="nombre_chofer"/>
                        </group>
                    </group>
                    <group string="Control de Pesos y Calidad">
                        <group>
                            <field name="variedad_arroz"/>
                            <field name="peso_bruto"/>
                            <field name="tara_camion"/>
                            <field name="peso_neto" readonly="1"/>
                        </group>
                        <group>
                            <field name="humedad"/>
                            <field name="impurezas"/>
                            <field name="peso_acondicionado" readonly="1"/>
                            <field name="silo_asignado"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista List / Tree -->
    <record id="view_recepcion_arroz_tree" model="ir.ui.view">
        <field name="name">recepcion.arroz.list</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <list string="Recepciones de Arroz">
                <field name="name"/>
                <field name="date_recepcion"/>
                <field name="partner_id"/>
                <field name="guia_sica"/>
                <field name="vehiculo_placa"/>
                <field name="variedad_arroz"/>
                <field name="peso_neto"/>
                <field name="peso_acondicionado"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_recepcion_arroz_search" model="ir.ui.view">
        <field name="name">recepcion.arroz.search</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <search string="Buscar Recepción">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="guia_sica"/>
                <field name="vehiculo_placa"/>
                <field name="chofer_cedula"/>
                <filter string="En Borrador" name="draft" domain="[('state', '=', 'borrador')]"/>
                <filter string="Completados" name="completed" domain="[('state', '=', 'completado')]"/>
                <separator/>
                <group>
                    <filter string="Productor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Variedad" name="group_variedad" context="{'group_by': 'variedad_arroz'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date_recepcion'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_recepcion_arroz" model="ir.actions.act_window">
        <field name="name">Recepciones de Arroz</field>
        <field name="res_model">recepcion.arroz</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_recepcion_arroz_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree el primer registro de recepción de arroz paddy.
            </p>
        </field>
    </record>

    <!-- Menús -->
    <menuitem id="menu_recepcion_digital_root" name="Recepción Digital" sequence="10"/>
    <menuitem id="menu_recepcion_operaciones" name="Operaciones" parent="menu_recepcion_digital_root" sequence="10"/>
    <menuitem id="menu_recepcion_arroz" name="Recepciones de Arroz" parent="menu_recepcion_operaciones" action="action_recepcion_arroz" sequence="10"/>

</odoo>