<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista Formulario -->
    <record id="view_recepcion_arroz_form" model="ir.ui.view">
        <field name="name">recepcion.arroz.form</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <form string="Recepción de Arroz">
                <header>
                    <button name="action_completar" string="Completar Recepción" type="object" class="oe_highlight" invisible="state == 'completado' or state == 'cancelado'"/>
                    <button name="action_draft" string="Volver a Borrador" type="object" invisible="state == 'borrador'"/>
                    <button name="action_cancelar" string="Cancelar" type="object" invisible="state == 'cancelado'"/>
                    <field name="state" widget="statusbar" statusbar_visible="borrador,pesaje_inicial,laboratorio,pesaje_final,completado"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Origen y Trazabilidad">
                            <field name="partner_id"/>
                            <field name="guia_sica"/>
                            <field name="date_recepcion"/>
                            <field name="variedad_arroz"/>
                        </group>
                        <group string="Datos del Transporte">
                            <field name="vehiculo_placa"/>
                            <field name="chofer_cedula"/>
                            <field name="chofer_nombre"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pesaje de Báscula (kg)">
                            <field name="peso_bruto"/>
                            <field name="peso_tara"/>
                            <field name="peso_neto" readonly="1"/>
                        </group>
                        <group string="Análisis de Laboratorio (%)">
                            <field name="porcentaje_humedad"/>
                            <field name="porcentaje_impureza"/>
                            <field name="porcentaje_grano_rojo"/>
                        </group>
                    </group>
                    <group string="Liquidación y Deducciones">
                        <group>
                            <field name="descuento_humedad_kg" readonly="1"/>
                            <field name="descuento_impureza_kg" readonly="1"/>
                        </group>
                        <group>
                            <field name="peso_acondicionado" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vista Lista (List / Tree) -->
    <record id="view_recepcion_arroz_tree" model="ir.ui.view">
        <field name="name">recepcion.arroz.list</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <list string="Recepciones de Arroz" decoration-info="state == 'borrador'" decoration-success="state == 'completado'" decoration-danger="state == 'cancelado'">
                <field name="name"/>
                <field name="date_recepcion"/>
                <field name="partner_id"/>
                <field name="guia_sica"/>
                <field name="vehiculo_placa"/>
                <field name="variedad_arroz"/>
                <field name="peso_bruto" sum="Total Peso Bruto"/>
                <field name="peso_tara" sum="Total Peso Tara"/>
                <field name="peso_neto" sum="Total Peso Neto"/>
                <field name="peso_acondicionado" sum="Total Peso Acondicionado"/>
                <field name="state" widget="badge" decoration-info="state == 'borrador'" decoration-success="state == 'completado'" decoration-danger="state == 'cancelado'"/>
            </list>
        </field>
    </record>

    <!-- Vista Búsqueda -->
    <record id="view_recepcion_arroz_search" model="ir.ui.view">
        <field name="name">recepcion.arroz.search</field>
        <field name="model">recepcion.arroz</field>
        <field name="arch" type="xml">
            <search string="Buscar Recepción">
                <field name="name" string="Folio / Referencia"/>
                <field name="partner_id" string="Productor / Proveedor"/>
                <field name="guia_sica" string="Guía SICA"/>
                <field name="vehiculo_placa" string="Placa"/>
                <field name="chofer_cedula" string="Cédula Conductor"/>
                <filter string="En Borrador" name="draft" domain="[('state', '=', 'borrador')]"/>
                <filter string="Completados" name="completed" domain="[('state', '=', 'completado')]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Productor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Estado" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Variedad" name="group_variedad" context="{'group_by': 'variedad_arroz'}"/>
                    <filter string="Fecha" name="group_date" context="{'group_by': 'date_recepcion:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de Ventana -->
    <record id="action_recepcion_arroz" model="ir.actions.act_window">
        <field name="name">Recepciones de Arroz</field>
        <field name="res_model">recepcion.arroz</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_recepcion_arroz_search"/>
    </record>

    <!-- Menús -->
    <menuitem id="menu_recepcion_digital_root" name="Recepción Digital" sequence="10"/>
    <menuitem id="menu_recepcion_operaciones" name="Operaciones" parent="menu_recepcion_digital_root" sequence="10"/>
    <menuitem id="menu_recepcion_arroz" name="Recepciones de Arroz" parent="menu_recepcion_operaciones" action="action_recepcion_arroz" sequence="10"/>

</odoo>