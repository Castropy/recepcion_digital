<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Herencia de la vista formulario de contactos/proveedores -->
    <record id="view_partner_form_recepcion_inherit" model="ir.ui.view">
        <field name="name">res.partner.form.recepcion.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Campo técnico invisible para evaluación de condiciones UI -->
            <xpath expr="//sheet" position="inside">
                <field name="recepcion_count" invisible="1"/>
            </xpath>
            
            <!-- Inserción del Smart Button en la caja de botones principal -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_recepciones_arroz"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="recepcion_count == 0">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="total_peso_acondicionado_kg" widget="float"/> kg
                        </span>
                        <span class="o_stat_text">
                            <field name="recepcion_count"/> Recepciones
                        </span>
                    </div>
                </button>
            </xpath>

            <!-- Inserción de la pestaña de Historial Agrícola y Calidad -->
            <xpath expr="//notebook" position="inside">
                <page string="Historial Agrícola" name="historial_agricola">
                    <group string="Promedios de Calidad Histórica">
                        <group>
                            <field name="promedio_humedad" readonly="1"/>
                            <field name="promedio_impureza" readonly="1"/>
                        </group>
                        <group>
                            <field name="promedio_grano_rojo" readonly="1"/>
                            <field name="total_peso_acondicionado_kg" readonly="1"/>
                        </group>
                    </group>
                    <field name="recepcion_arroz_ids" readonly="1">
                        <list default_order="date_recepcion desc">
                            <field name="name"/>
                            <field name="date_recepcion"/>
                            <field name="variedad_arroz"/>
                            <field name="peso_bruto"/>
                            <field name="peso_neto"/>
                            <field name="peso_acondicionado"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>