<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_recepcion_inherit" model="ir.ui.view">
        <field name="name">res.users.form.recepcion.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="inside">
                <group string="RECEPCIÓN DIGITAL">
                    <field name="has_group('recepcion_digital.group_recepcion_romana')" string="Operador de Romana"/>
                    <field name="has_group('recepcion_digital.group_recepcion_laboratorio')" string="Analista de Laboratorio"/>
                    <field name="has_group('recepcion_digital.group_recepcion_manager')" string="Administrador / Gerente"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>