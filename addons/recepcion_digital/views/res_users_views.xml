<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_recepcion_inherit" model="ir.ui.view">
        <field name="name">res.users.form.recepcion.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="inside">
                <group string="Recepción Digital - Colaboradores">
                    <field name="area_trabajo" readonly="0"/>
                    <field name="groups_id"
                           widget="many2many_checkboxes"
                           domain="[('category_id', '=', ref('recepcion_digital.module_category_recepcion_digital'))]"
                           string="Roles en Recepción Digital"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>