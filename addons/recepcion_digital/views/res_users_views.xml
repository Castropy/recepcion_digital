<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_recepcion_inherit" model="ir.ui.view">
        <field name="name">res.users.form.recepcion.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='access_rights']" position="inside">
                <group string="RECEPCIÓN DIGITAL">
                    <field name="group_ids" 
                           widget="many2many_checkboxes" 
                           domain="[('name', 'in', [
                               'Recepción Digital / Operador de Romana',
                               'Recepción Digital / Analista de Laboratorio',
                               'Recepción Digital / Administrador / Gerente'
                           ])]" 
                           nolabel="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>